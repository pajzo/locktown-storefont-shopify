</div>

{% stylesheet %}
  .mx-text {
    /*text-align: center;*/
    /*font-size: var(--text-h5) !important;*/
    margin-bottom: 10px;
  }

  .mx-text .no-margin {
    margin: 0 !important;
  }

  .mx-offers {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 5px;
  }

  .mx-offer-item {
    font-size: var(--text-base) !important;
    font-weight: normal !important;
    /*background-color: #E3B9C9 !important;    */
    border: 3px solid #e3b9c9;
    color: #000000 !important;    
    text-align: center !important;
    padding: 10px 20px !important;
    flex-grow: 1;
    border-radius: 24px;
  }
{% endstylesheet %}
