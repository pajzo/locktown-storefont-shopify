<style>
.lktn-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.lktn-chip-wrap {
  position: relative;
  display: inline-block;
}
.lktn-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: #fce8f0;
  border: 1px solid #f4b8d0;
  border-radius: 999px;
  padding: 6px 14px;
  font-size: 13px;
  font-weight: 500;
  color: #8c2d50;
  cursor: pointer;
  user-select: none;
  transition: background .15s;
}
.lktn-chip:hover {
  background: #f9d5e7;
}
.lktn-icon {
  flex-shrink: 0;
  opacity: .6;
}
.lktn-tooltip {
  position: absolute;
  top: calc(100% + 10px);
  left: 50%;
  transform: translateX(-50%);
  background: #fff;
  border: 1px solid #eee;
  border-radius: 10px;
  padding: 12px 16px;
  min-width: 210px;
  box-shadow: 0 4px 20px rgba(0,0,0,.1);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s;
}
.lktn-tooltip.lktn-visible {
  opacity: 1;
  pointer-events: auto;
}
.lktn-tooltip::before {
  content: '';
  position: absolute;
  top: -6px;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 10px;
  height: 10px;
  background: #fff;
  border-left: 1px solid #eee;
  border-top: 1px solid #eee;
}
.lktn-tooltip-price {
  font-size: 13px;
  font-weight: 500;
  color: #111;
  margin-bottom: 6px;
}
.lktn-tooltip-note {
  font-size: 11.5px;
  color: #aaa;
  line-height: 1.5;
}
</style>

<script>
(function() {
  var chips = document.querySelectorAll('.lktn-chip');
  chips.forEach(function(chip) {
    var tooltip = chip.closest('.lktn-chip-wrap').querySelector('.lktn-tooltip');
    chip.addEventListener('click', function(e) {
      e.stopPropagation();
      var isVisible = tooltip.classList.contains('lktn-visible');
      document.querySelectorAll('.lktn-tooltip.lktn-visible').forEach(function(t) {
        t.classList.remove('lktn-visible');
      });
      if (!isVisible) tooltip.classList.add('lktn-visible');
    });
  });
  document.addEventListener('click', function() {
    document.querySelectorAll('.lktn-tooltip.lktn-visible').forEach(function(t) {
      t.classList.remove('lktn-visible');
    });
  });
})();
</script>