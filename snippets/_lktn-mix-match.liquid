<div class="lktn-mixmatch">
  <div class="lktn-mixmatch__header">Mix & Match – køb flere, spar mere</div>
  <div class="lktn-mixmatch__subheading">
    Frit valg mellem alle NoShow-modeller og størrelser.<br>
    Vælg en færdig pakke – eller kombiner selv.<br>
    <small>Rabatten fratrækkes automatisk.</small>
  </div>

  <div class="lktn-mixmatch__packages">
    <div class="mm-package-item" data-qty="3">
      <div class="mm-badge">🌱 God start</div>
      <div class="mm-package-row mm-package-first">
        <div class="mm-name">3 par</div>
        <div class="mm-now">349 kr.</div>
      </div>
      <div class="mm-package-row mm-package-second">
        <div class="mm-qty">116 kr pr. par</div>
        <div class="mm-before">447 kr.</div>
      </div>
    </div>

    <div class="mm-package-item" data-qty="6">
      <div class="mm-badge">⭐ Smart valg</div>
      <div class="mm-package-row mm-package-first">
        <div class="mm-name">6 par</div>
        <div class="mm-now">499 kr.</div>
      </div>
      <div class="mm-package-row mm-package-second">
        <div class="mm-qty">83 kr pr. par</div>
        <div class="mm-before">894 kr.</div>
      </div>
    </div>

    <div class="mm-package-item" data-qty="9">
      <div class="mm-badge">💰 Bedste værdi</div>
      <div class="mm-package-row mm-package-first">
        <div class="mm-name">9 par</div>
        <div class="mm-now">699 kr.</div>
      </div>
      <div class="mm-package-row mm-package-second">
        <div class="mm-qty">77 kr pr. par</div>
        <div class="mm-before">1.341 kr.</div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .lktn-mixmatch__header {
    font-weight: bold;
    font-size: 20px;
    text-align: center;
  }

  .lktn-mixmatch__subheading {
    text-align: center;
    margin-bottom: 10px;
  }

  .lktn-mixmatch__packages {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .mm-package-item {
    padding: 10px 25px;
    border-color: #e3b9c9;
    border-width: 1px;
    border-radius: 42px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    cursor: pointer;
    position: relative;
  }

  .mm-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: #000000;
    color: #FFFFFF;
    font-size: 10px;
    padding: 2px 10px;
    border-radius: 42px;
  }

  .mm-selected {
    background-color: #f8f1f4;
    border-color: #000000;
  }

  .mm-package-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .mm-name, .mm-now {
    font-size: 18px;
    font-weight: 600;
  }

  .mm-qty {
    font-size: 13px;
  }

  .mm-before {
    opacity: 0.5;
    text-decoration: line-through;
    font-size: 14px;
    font-weight: 400;
  }
{% endstylesheet %}

{% javascript %}

  function mmSetup() {

    const packages = document.querySelectorAll('.mm-package-item');
    const quantityInput = document.querySelector('.quantity-selector__input');

    packages.forEach((p) => {

      if (p.classList.contains('mm-setup')){
        console.log('mm-setup event is already added');
      } else {
        p.classList.add('mm-setup');
        p.addEventListener('click', function () {
          const qty = p.getAttribute('data-qty');        
          quantityInput.value = qty;
          quantityInput.dispatchEvent(new Event('change'))
          
        });
      }
    });

    quantityInput.addEventListener('change', function(){      
      packages.forEach(p => {
        p.classList.remove('mm-selected');
      });

      var newPackage = document.querySelector('.mm-package-item[data-qty="' + quantityInput.value + '"]');
      if (newPackage != null) {
        newPackage.classList.add('mm-selected');
      }
    });    

    requestAnimationFrame(() => {
        requestAnimationFrame(() => {
            quantityInput.dispatchEvent(new Event('change'));
        })
    });

  }

  document.addEventListener('variant:change', () => mmSetup());
  document.addEventListener('DOMContentLoaded', () => mmSetup());

{% endjavascript %}
