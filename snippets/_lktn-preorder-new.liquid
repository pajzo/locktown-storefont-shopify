{% liquid
  assign variant = product.selected_or_first_available_variant
  assign formatted_date = variant.next_incoming_date | date: format: 'abbreviated_date'
  assign preorder = false
  assign subscribe = false

  if variant.available and variant.inventory_policy == 'continue' and variant.inventory_quantity <= 0 and variant.requires_shipping and variant.incoming and variant.next_incoming_date
    assign preorder = true
  elsif variant.inventory_quantity <= 0
    assign subscribe = true
  endif

  if sandbox 
    assign preorder = true
    assign subscribe = false
    assign formatted_date = '14. oktober'
  endif

  if product == nil 
    assign subscribe = true
  endif
%}

{%- if subscribe -%}
  <div class="lktn-preorder lktn-preorder-subscribe" id="lktn-preorder-subscribe-container" data-product="{{ product.id | default: product_id }}" data-variant="{{ variant.id | default: '0' }}">
    <div class="lktn-preorder__line">
      <div class="preorder-icon">🔔</div>
      <div class="lktn-preorder__infoitems">
        <div><strong>Vil du have besked?</strong></div>
        <div>
          {{ product.title | default: product_title }} {{ variant.title }} er på vej – vi kender ikke datoen endnu. Tilmeld dig, og vi sender dig en mail, så snart vi åbner for bestillinger ♥︎
        </div>
        <div><input class="input" id="preorder-subscribe-email" type="text" placeholder="Email adresse"></div>
        <div><button id="preorder-subscribe-button" class="button" onclick="lktnPreorderSubscribe()">Giv mig besked</button></div>
        <div id="lktn-preorder-msg"></div>
      </div>
    </div>
  </div>

  <style>
    .product-info__inventory, .lktn-inventory-box, .product-info__quantity-selector, .product-info__buy-buttons, .lktn-mixmatch {
      display: none;
    }
  </style>
{%- endif -%}

{%- if preorder -%}
  <div class="lktn-preorder">
    <div class="lktn-preorder__line">
      <div class="preorder-icon">🔔</div>
      <div class="preorder-text">
        <strong>{{ shop.metafields.lktn.preoder_text_header }}</strong><br>
        Forventet på lager: {{ formatted_date }}
      </div>
    </div>
  </div>

  <style>
    .product-info__inventory, .lktn-inventory-box  {
        display: none;
    }
  </style>
{%- endif -%}

{% stylesheet %}
  .lktn-preorder {
    padding: 10px 25px;
    border: 1px solid #FFB74A;
    border-radius: 42px;
  }

  .lktn-preorder__line {
    display: flex;
    flex-direction: row;
    gap: 15px;
    align-items: center;
  }

  .lktn-preorder__line .preorder-icon {
    font-size: 30px;
  }

  .preorder-info {
    font-style: italic;
    font-size: 10px;
  }

  .lktn-preorder__infoitems {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  #preorder-subscribe-button {
    width: 100%;
  }

  #lktn-preorder-msg {
    text-align: center;
  }

  #lktn-preorder-msg.error {
    color: red;
  }

  #lktn-preorder-msg.success {
    color: green;
  }
{% endstylesheet %}


<script>
  async function lktnPreorderSubscribe() {

    const msgContainer = document.getElementById('lktn-preorder-msg');
    const email = document.getElementById('preorder-subscribe-email').value;
    const productId = document.getElementById('lktn-preorder-subscribe-container').dataset.product;
    const variantId = document.getElementById('lktn-preorder-subscribe-container').dataset.variant;

    msgContainer.innerHTML = "";
    msgContainer.classList.remove("success");
    msgContainer.classList.remove("error");

    const payload = {
      email: email,
      productId: productId,
      variantId: variantId
    };

    try {
      const res = await fetch("https://api.lktn.dk/waitlist", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        msgContainer.classList.add("success");
        msgContainer.innerHTML = "Tak! Vi sender dig en mail, når varen er klar til bestilling.";
      } else {
        msgContainer.classList.add("error");
        msgContainer.innerHTML = "Noget gik galt (" + res.status + "). Prøv igen.";
      }
    } catch (err) {
      msgContainer.classList.add("error");
      msgContainer.innerHTML = "Kunne ikke kontakte serveren. Tjek din forbindelse og prøv igen.";
    }
  }
</script>