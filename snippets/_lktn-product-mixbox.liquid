{%- comment -%}
  LKTN Bundle Builder v1.1 (works)
  - Accordion banners: 1 / 3 / 6 / 9 (default open: 3)
  - Global Size selector (no theme collisions: ltbb-* classes)
  - Models: Low / Mid / High (products by handle)
  - Color per model, qty per model
  - Adds correct variant IDs to cart via /cart/add.js
  - Uses /products/{handle}.js to resolve variants

  IMPORTANT: Set handles below.
{%- endcomment -%}

{% assign low_handle  = 'noshow-low-waist'  %}
{% assign mid_handle  = 'noshow-mid-waist'  %}
{% assign high_handle = 'noshow-high-waist' %}

<style>
  .lt-bundles{--bg:#f4f1ec;--card:#fff;--border:rgba(0,0,0,.10);--text:rgba(0,0,0,.88);--muted:rgba(0,0,0,.55);--accent:#1f7a6b;--accent2:#4a123a;--active:#0f3f37;--radius:22px;font-family:inherit;color:var(--text)}
  .lt-bundles__wrap{background:var(--bg);border-radius:28px;padding:18px}
  .lt-bundles__title{font-weight:900;font-size:18px;margin:0 0 12px}
  .lt-acc{display:flex;flex-direction:column;gap:14px}

  .lt-banner{background:var(--card);border:1px solid var(--border);border-radius:28px;overflow:hidden}
  .lt-banner.is-open{box-shadow:0 0 0 2px rgba(31,122,107,.55);border-color:transparent}

  .lt-banner__head{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px;border:0;background:transparent;cursor:pointer;text-align:left}
  .lt-banner__left{display:flex;align-items:center;gap:14px;min-width:0}
  .lt-banner__icon{width:54px;height:54px;border-radius:16px;background:rgba(0,0,0,.04);display:flex;align-items:center;justify-content:center;font-weight:900;color:rgba(0,0,0,.35);flex:0 0 auto}
  .lt-banner__meta{min-width:0}
  .lt-banner__h{margin:0;font-weight:900;font-size:20px;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .lt-banner__sub{margin:6px 0 0 0;font-size:14px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .lt-banner__right{display:flex;align-items:center;gap:12px;flex:0 0 auto}
  .lt-pill{font-size:11px;font-weight:900;letter-spacing:.03em;text-transform:uppercase;padding:7px 10px;border-radius:999px;color:#fff;background:var(--accent)}
  .lt-pill.alt{background:var(--accent2)}
  .lt-price{display:flex;align-items:baseline;gap:10px;white-space:nowrap;font-weight:900}
  .lt-old{font-size:14px;color:rgba(0,0,0,.30);text-decoration:line-through}
  .lt-now{font-size:18px}
  .lt-unit{font-size:14px;color:var(--muted);font-style:italic;margin-left:4px}
  .lt-chev{width:38px;height:38px;border-radius:14px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;background:#fff}
  .lt-chev svg{width:18px;height:18px;transition:transform .15s ease}
  .lt-banner.is-open .lt-chev svg{transform:rotate(180deg)}
  .lt-banner__body{padding:0 16px 16px;border-top:1px solid rgba(0,0,0,.08)}
  .lt-banner:not(.is-open) .lt-banner__body{display:none}

  .lt-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px}
  .lt-label{font-weight:900}

  /* SIZE (renamed to avoid theme collisions) */
  .ltbb-sizes{display:flex;flex-wrap:wrap;gap:8px}
  .ltbb-size{background:#fff;border:1px solid var(--border);border-radius:999px;padding:8px 12px;font-weight:800;cursor:pointer}
  .ltbb-size.is-active{background:var(--active);color:#fff;border-color:transparent}

  .lt-progress{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px}
  .lt-bar{flex:1;height:10px;border-radius:999px;background:rgba(0,0,0,.08);overflow:hidden}
  .lt-fill{height:100%;width:0%;background:linear-gradient(90deg, rgba(31,122,107,.95), rgba(31,122,107,.55))}
  .lt-count{font-weight:900;white-space:nowrap}

  .lt-models{margin-top:14px;background:#fff;border:1px solid var(--border);border-radius:26px;padding:14px}
  .lt-modelsTop{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
  .lt-modelsTitle{font-weight:900}
  .lt-hint{font-size:12px;color:var(--muted)}
  .lt-cards{display:flex;gap:12px;overflow:auto;padding-bottom:6px;scroll-snap-type:x mandatory}
  .lt-card{min-width:230px;max-width:230px;scroll-snap-align:start;border:1px solid var(--border);border-radius:22px;overflow:hidden;background:#fff}
  .lt-img{height:140px;background:rgba(0,0,0,.04);display:flex;align-items:center;justify-content:center}
  .lt-img span{font-weight:900;color:rgba(0,0,0,.35)}
  .lt-body{padding:12px}
  .lt-title{margin:0 0 6px;font-weight:900}
  .lt-sub{margin:0 0 10px;font-size:12px;color:var(--muted)}
  .lt-swatches{display:flex;gap:8px;margin:0 0 12px}
  .lt-swatch{width:22px;height:22px;border-radius:999px;border:1px solid rgba(0,0,0,.18);cursor:pointer}
  .lt-swatch.is-active{outline:2px solid rgba(0,0,0,.7)}
  .lt-swatch[data-color="Black"], .lt-swatch[data-color="Sort"]{background:#111}
  .lt-swatch[data-color="Beige"]{background:#d8c7ad}
  .lt-qtyRow{display:flex;align-items:center;justify-content:space-between;gap:10px}
  .lt-btn{width:40px;height:40px;border-radius:14px;border:1px solid var(--border);background:#fff;cursor:pointer;font-size:18px;font-weight:900}
  .lt-qty{min-width:22px;text-align:center;font-weight:900}

  .lt-footer{margin-top:14px;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fff;border:1px solid var(--border);border-radius:22px;padding:12px 14px}
  .lt-cta{border:0;border-radius:16px;padding:12px 16px;font-weight:900;cursor:pointer;background:var(--active);color:#fff}
  .lt-cta[disabled]{opacity:.45;cursor:not-allowed}
  .lt-msg{margin-top:10px;font-size:13px;color:var(--muted)}
  .lt-msg.is-error{color:crimson}

  @media (max-width:760px){.lt-banner__h{font-size:18px}.lt-card{min-width:210px;max-width:210px}}
</style>

<div class="lt-bundles"
     data-lt-bundles
     data-low-handle="{{ low_handle }}"
     data-mid-handle="{{ mid_handle }}"
     data-high-handle="{{ high_handle }}">

  <div class="lt-bundles__wrap">
    <p class="lt-bundles__title">Vælg pakke — og byg den som du vil</p>

    <div class="lt-acc">
      <div class="lt-banner" data-pack="1">
        <button class="lt-banner__head" type="button">
          <div class="lt-banner__left">
            <div class="lt-banner__icon">1</div>
            <div class="lt-banner__meta">
              <p class="lt-banner__h">1 par</p>
              <p class="lt-banner__sub">Perfekt hvis du vil prøve først</p>
            </div>
          </div>
          <div class="lt-banner__right">
            <div class="lt-price"><span class="lt-now">149 kr <span class="lt-unit">pr. par</span></span></div>
            <div class="lt-chev" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div>
        </button>
        <div class="lt-banner__body" data-body></div>
      </div>

      <div class="lt-banner is-open" data-pack="3">
        <button class="lt-banner__head" type="button">
          <div class="lt-banner__left">
            <div class="lt-banner__icon">3</div>
            <div class="lt-banner__meta">
              <p class="lt-banner__h">3 par</p>
              <p class="lt-banner__sub">Vores mest valgte pakke</p>
            </div>
          </div>
          <div class="lt-banner__right">
            <span class="lt-pill">Populær</span>
            <div class="lt-price"><span class="lt-old">149 kr</span><span class="lt-now">349 kr <span class="lt-unit">i alt</span></span></div>
            <div class="lt-chev" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div>
        </button>
        <div class="lt-banner__body" data-body></div>
      </div>

      <div class="lt-banner" data-pack="6">
        <button class="lt-banner__head" type="button">
          <div class="lt-banner__left">
            <div class="lt-banner__icon">6</div>
            <div class="lt-banner__meta">
              <p class="lt-banner__h">6 par</p>
              <p class="lt-banner__sub">Bland frit og få større besparelse</p>
            </div>
          </div>
          <div class="lt-banner__right">
            <div class="lt-price"><span class="lt-old">149 kr</span><span class="lt-now">499 kr <span class="lt-unit">i alt</span></span></div>
            <div class="lt-chev" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div>
        </button>
        <div class="lt-banner__body" data-body></div>
      </div>

      <div class="lt-banner" data-pack="9">
        <button class="lt-banner__head" type="button">
          <div class="lt-banner__left">
            <div class="lt-banner__icon">9</div>
            <div class="lt-banner__meta">
              <p class="lt-banner__h">9 par</p>
              <p class="lt-banner__sub">Maksimal besparelse pr. par</p>
            </div>
          </div>
          <div class="lt-banner__right">
            <span class="lt-pill alt">Bedste værdi</span>
            <div class="lt-price"><span class="lt-old">149 kr</span><span class="lt-now">649 kr <span class="lt-unit">i alt</span></span></div>
            <div class="lt-chev" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div>
        </button>
        <div class="lt-banner__body" data-body></div>
      </div>
    </div>

    <div class="lt-msg" data-msg></div>
  </div>
</div>

<script>
(() => {
  const root = document.querySelector('[data-lt-bundles]');
  if (!root) return;

  const handles = {
    low: root.dataset.lowHandle,
    mid: root.dataset.midHandle,
    high: root.dataset.highHandle
  };

  const msgEl = root.querySelector('[data-msg]');
  const banners = [...root.querySelectorAll('.lt-banner')];

  const state = {
    packQty: 3,
    size: 'M',
    model: {
      low:  { color: 'Black', qty: 0 },
      mid:  { color: 'Black', qty: 0 },
      high: { color: 'Black', qty: 0 }
    },
    products: new Map()
  };

  const setMsg = (text, isError=false) => {
    msgEl.textContent = text || '';
    msgEl.classList.toggle('is-error', !!isError);
  };

  const normalize = s => (s || '').toString().trim().toLowerCase();

  function renderBody(packQty){
    return `
      <div class="lt-row">
        <div class="lt-label">Vælg størrelse</div>
        <div class="ltbb-sizes" role="list">
          ${['XS','S','M','L','XL'].map(s => `
            <button type="button" class="ltbb-size ${state.size===s?'is-active':''}" data-ltbb-size="${s}">${s}</button>
          `).join('')}
        </div>
      </div>

      <div class="lt-progress" aria-label="Pakke status">
        <div class="lt-bar"><div class="lt-fill" data-fill style="width:0%"></div></div>
        <div class="lt-count"><span data-picked>0</span>/${packQty} valgt</div>
      </div>

      <div class="lt-models">
        <div class="lt-modelsTop">
          <div class="lt-modelsTitle">Vælg pasform</div>
          <div class="lt-hint">Mix Low / Mid / High — farve pr. model</div>
        </div>

        <div class="lt-cards" aria-label="Vælg modeller">
          ${['low','mid','high'].map(key => `
            <div class="lt-card" data-model="${key}">
              <div class="lt-img"><span>${key.toUpperCase()}</span></div>
              <div class="lt-body">
                <p class="lt-title">${key === 'low' ? 'NoShow Low' : key === 'mid' ? 'NoShow Mid' : 'NoShow High'}</p>
                <p class="lt-sub">${key === 'low' ? 'Lav talje' : key === 'mid' ? 'Mellem talje' : 'Høj talje'}</p>

                <div class="lt-swatches" role="list">
                  ${['Black','Beige'].map(c => `
                    <button type="button" class="lt-swatch ${state.model[key].color===c?'is-active':''}" data-color="${c}" aria-label="${c}"></button>
                  `).join('')}
                </div>

                <div class="lt-qtyRow">
                  <button type="button" class="lt-btn" data-dec aria-label="Minus">−</button>
                  <div class="lt-qty" data-qty>${state.model[key].qty}</div>
                  <button type="button" class="lt-btn" data-inc aria-label="Plus">+</button>
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      </div>

      <div class="lt-footer">
        <div>
          <div style="font-weight:900">Din pakke</div>
          <div style="font-size:12px;color:var(--muted)">Vælg præcis <strong>${packQty}</strong> par</div>
        </div>
        <button class="lt-cta" type="button" data-add disabled>Tilføj til kurv</button>
      </div>
    `;
  }

  function pickedTotal(){
    return Object.values(state.model).reduce((sum, x) => sum + x.qty, 0);
  }

  function clampToMax(max, preferredKey){
    let total = pickedTotal();
    if (total <= max) return;

    const order = preferredKey ? [preferredKey, ...['low','mid','high'].filter(k => k !== preferredKey)] : ['low','mid','high'];
    while (total > max) {
      let changed = false;
      for (const k of order) {
        if (state.model[k].qty > 0) {
          state.model[k].qty -= 1;
          total -= 1;
          changed = true;
          break;
        }
      }
      if (!changed) break;
    }
  }

  function openBanner(packQty){
    state.packQty = packQty;
    setMsg('');

    banners.forEach(b => b.classList.toggle('is-open', parseInt(b.dataset.pack,10) === packQty));
    const current = banners.find(b => parseInt(b.dataset.pack,10) === packQty);
    if (!current) return;

    banners.forEach(b => {
      const body = b.querySelector('[data-body]');
      if (!body) return;
      body.innerHTML = (b === current) ? renderBody(packQty) : '';
    });

    clampToMax(packQty);
    bindBody(current);
    syncBody(current);
  }

  function bindBody(banner){
    const body = banner.querySelector('[data-body]');
    if (!body) return;

    body.addEventListener('click', async (e) => {
      // Prevent theme/accordion interference
      e.stopPropagation();

      const sizeBtn = e.target.closest('button.ltbb-size');
      if (sizeBtn) {
        state.size = sizeBtn.dataset.ltbbSize;
        syncBody(banner);
        return;
      }

      const swatch = e.target.closest('button.lt-swatch');
      if (swatch) {
        const card = swatch.closest('[data-model]');
        const modelKey = card?.dataset.model;
        if (!modelKey) return;
        state.model[modelKey].color = swatch.dataset.color;
        syncBody(banner);
        return;
      }

      const inc = e.target.closest('button[data-inc]');
      if (inc) {
        const card = inc.closest('[data-model]');
        const modelKey = card?.dataset.model;
        if (!modelKey) return;

        state.model[modelKey].qty += 1;
        clampToMax(state.packQty, modelKey);
        syncBody(banner);
        return;
      }

      const dec = e.target.closest('button[data-dec]');
      if (dec) {
        const card = dec.closest('[data-model]');
        const modelKey = card?.dataset.model;
        if (!modelKey) return;

        state.model[modelKey].qty = Math.max(0, state.model[modelKey].qty - 1);
        syncBody(banner);
        return;
      }

      const addBtn = e.target.closest('[data-add]');
      if (addBtn) {
        await addToCart(addBtn);
      }
    });
  }

  function syncBody(banner){
    const body = banner.querySelector('[data-body]');
    if (!body) return;

    body.querySelectorAll('.ltbb-size').forEach(btn => {
      btn.classList.toggle('is-active', btn.dataset.ltbbSize === state.size);
    });

    body.querySelectorAll('[data-model]').forEach(card => {
      const key = card.dataset.model;
      card.querySelector('[data-qty]').textContent = String(state.model[key].qty);
      card.querySelectorAll('.lt-swatch').forEach(sw => {
        sw.classList.toggle('is-active', sw.dataset.color === state.model[key].color);
      });
    });

    const total = pickedTotal();
    const fill = body.querySelector('[data-fill]');
    const picked = body.querySelector('[data-picked]');
    if (picked) picked.textContent = String(total);
    if (fill) fill.style.width = `${Math.min(100, (total / state.packQty) * 100)}%`;

    const addBtn = body.querySelector('[data-add]');
    if (addBtn) addBtn.disabled = !(total === state.packQty);
  }

  async function getProduct(handle){
    if (state.products.has(handle)) return state.products.get(handle);
    const res = await fetch(`/products/${handle}.js`);
    if (!res.ok) throw new Error(`Kunne ikke hente produkt: ${handle}`);
    const product = await res.json();
    state.products.set(handle, product);
    return product;
  }

  function findVariantId(product, sizeValue, colorValue){
    const optNames = (product.options || []).map(normalize);
    const sizeIdx  = optNames.findIndex(n => n.includes('size') || n.includes('størrelse'));
    const colorIdx = optNames.findIndex(n => n.includes('color') || n.includes('farve'));

    const needSize  = normalize(sizeValue);
    const needColor = normalize(colorValue);

    const match = (product.variants || []).find(v => {
      if (v.available === false) return false;
      const opts = [v.option1, v.option2, v.option3].map(normalize);
      const sizeOk  = sizeIdx  === -1 ? true : opts[sizeIdx]  === needSize;
      const colorOk = colorIdx === -1 ? true : opts[colorIdx] === needColor;
      return sizeOk && colorOk;
    });

    return match ? match.id : null;
  }

  async function addToCart(btn){
    setMsg('');

    const total = pickedTotal();
    if (total !== state.packQty) {
      setMsg(`Vælg præcis ${state.packQty} par før du kan tilføje.`, true);
      return;
    }

    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = 'Tilføjer...';

    try {
      const items = [];
      for (const key of ['low','mid','high']) {
        const qty = state.model[key].qty;
        if (!qty) continue;

        const handle = handles[key];
        if (!handle) throw new Error(`Mangler handle for ${key}`);

        const product = await getProduct(handle);
        const vid = findVariantId(product, state.size, state.model[key].color);
        if (!vid) throw new Error(`Kan ikke finde variant for ${key.toUpperCase()} (${state.size} / ${state.model[key].color}).`);

        items.push({ id: vid, quantity: qty });
      }

      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept':'application/json' },
        body: JSON.stringify({ items })
      });

      if (!res.ok) {
        const t = await res.text();
        throw new Error(t || 'Kunne ikke tilføje til kurv.');
      }

      setMsg('Tilføjet til kurv ✅');
    } catch (err) {
      setMsg('Fejl: ' + (err?.message || 'Ukendt fejl'), true);
    } finally {
      btn.textContent = original;
      btn.disabled = false;
    }
  }

  // Open banner on header click
  banners.forEach(b => {
    const head = b.querySelector('.lt-banner__head');
    head.addEventListener('click', () => openBanner(parseInt(b.dataset.pack, 10)));
  });

  // Init
  openBanner(3);
})();
</script>