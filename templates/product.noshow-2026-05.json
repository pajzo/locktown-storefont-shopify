    "media_with_text_eWTwCA": {
      "type": "media-with-text",
      "blocks": {
        "image_nbajXd": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/NS_HIGH_WAIST_BLACK__Studio__Raw.png",
            "media_width": 50,
            "media_position": "start",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "Usynlig under tøjet",
            "title": "Trusser, du ikke skal tænke over",
            "content": "<p>NoShow er lavet til at forsvinde under kjoler, leggings og jeans. Seamless, glat og behagelig — så du slipper for kanter, linjer og små justeringer i løbet af dagen.</p>",
            "link_text": "",
            "link_url": "",
            "background": "#000000",
            "background_gradient": "",
            "text_color": "#ffffff",
            "text_gradient": "",
            "button_background": "",
